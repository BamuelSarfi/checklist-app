# checklist-app (kitchen kiosk) - production env vars.
# One deployment = one kitchen. Copy this file to `.env` per-kitchen container and fill in
# real values; never commit the filled-in file.

# --- Required at boot (server.js exits immediately if any of these are missing) ---
PORT=3002
DATABASE_URL=postgres://user:password@host:5432/dbname
COOKIE_SECRET=                  # random 32+ char string - signs the employeeId/sessionToken cookies
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# --- Postgres connection details ---
PGSSL=true                      # required for most managed Postgres providers (Scaleway included)
SCHEMA_NAME=kiosk                # this app's schema; checklist-app-fend uses a separate `safecater` schema in the same DB

# --- R2 / S3-compatible storage ---
# Use the EU jurisdiction endpoint, not the default global one - requires a bucket created
# with jurisdiction=eu (Cloudflare dashboard, or `wrangler r2 bucket create <name>
# --jurisdiction=eu`); jurisdiction can't be changed on an existing bucket after creation.
R2_ENDPOINT=https://<account_id>.eu.r2.cloudflarestorage.com
R2_SIGNED_URL_EXPIRES_IN=3600

# --- Links this kiosk to its portal account (checklist-app-fend) ---
# All three must be set together for employee sync + record mirroring to work - if any is
# missing, employeeDirectory.js/recordSync.js silently fall back to local-only behavior.
SAFECATER_BASE_API_URL=https://portal.example.com
SAFECATER_KITCHEN_ID=
SAFECATER_SERVICE_API_KEY=       # must match checklist-app-fend's SERVICE_API_KEY exactly

NODE_ENV=production
